# OpenRouter API key (required for transcription, summarization, and embeddings)
OPENROUTER_API_KEY=

# Docker image tag (default: ghcr.io/macsatcom/podcast-transcription-search:latest)
# IMAGE=ghcr.io/macsatcom/podcast-transcription-search:latest

# Database connection string (optional, defaults to local dev value)
# DATABASE_URL=postgresql+asyncpg://podcast:podcast@localhost/podcast_transcription_search

# Base directory for persistent data (database, audio cache, portal images, whisper models)
# Defaults to ./data relative to docker-compose.yml
# DATA_DIR=./data

# Host ports (optional, shown with defaults)
# WEB_PORT=8002
# PORTAL_PORT_RANGE=9000-9010
# WHISPER_CPU_PORT=9050
# WHISPER_ROCM_PORT=9001
